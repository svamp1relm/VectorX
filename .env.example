# Строка подключения к PostgreSQL. Обязательна для CLI (vectorx run ...) и для api/main.py.
# Для локального docker-compose (docker compose up -d postgres) с настройками по умолчанию:
VECTORX_DATABASE_URL=postgresql+psycopg://vectorx:vectorx@localhost:55432/vectorx

# Хост-порт для docker-compose Postgres. По умолчанию отличается от стандартного 5432,
# чтобы не конфликтовать с уже установленным локальным PostgreSQL.
VECTORX_POSTGRES_PORT=55432

# Порт API отличается от стандартного 8000, часто занятого другими dev-серверами.
VECTORX_API_PORT=8001

# Единственный каталог, из которого API разрешает читать CSV. Абсолютные пути,
# относительные пути с `..` и symlinks за его пределами отклоняются.
VECTORX_DATA_ROOT=configs/experiments/data

# Разрешённые CORS-origin для API (через запятую). По умолчанию уже покрывает Vite dev server
# (localhost:5173 / 127.0.0.1:5173) — переопределяйте только для нестандартного порта/хоста.
VECTORX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
