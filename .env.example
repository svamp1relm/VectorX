# Строка подключения к PostgreSQL. Обязательна для CLI (vectorx run ...) и для api/main.py.
# Для локального docker-compose (docker compose up -d postgres) с настройками по умолчанию:
VECTORX_DATABASE_URL=postgresql+psycopg://vectorx:vectorx@localhost:5432/vectorx

# Хост-порт для docker-compose Postgres (опционально). Меняйте, если 5432 уже занят
# другим локальным Postgres — и не забудьте поправить порт в VECTORX_DATABASE_URL выше.
VECTORX_POSTGRES_PORT=5432

# Разрешённые CORS-origin для API (через запятую). По умолчанию уже покрывает Vite dev server
# (localhost:5173 / 127.0.0.1:5173) — переопределяйте только для нестандартного порта/хоста.
VECTORX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
